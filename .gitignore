/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch
/scratch
/cek*.png
/Maxy Academy_Logogram-*.png

# Dummy scripts
delete_dummy_tasks.js
read_priorities.js

# Markdown notes & audit files (local only)
*.md
!README.md

# Hasil audit & probe. Isinya balasan API sungguhan — nama, email, dan agregat
# karyawan asli — jadi tempatnya bukan di repo yang bisa dibaca siapa pun yang
# punya akses kode.
/audit/

# Dump/backup tabel. Sama alasannya: baris di dalamnya milik orang sungguhan.
backup-*.json

# Harness sekali pakai untuk menguji koneksi DB & jalur login di lokal. Berguna
# saat menelusuri bug, tapi bukan bagian dari aplikasi yang dijalankan server.
/test-*.ts
/scripts-tmp-*.ts
